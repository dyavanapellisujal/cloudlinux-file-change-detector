+++ b/detector/watchset.py
@@ -0,0 +1,97 @@
+"""
+watchset.py — the policy layer: *which* changes are worth scanning, and how we
+tell a MEANINGFUL change apart from noise.
+
+Pure and dependency-free: no Linux-specific calls live here, so this module is
+unit-testable on any OS (macOS included). The fanotify producer and the sender
+both lean on these helpers.
+
+Policy (from the Product Owner):
+  Relevant  : *.php *.phtml *.php5 *.phar *.inc, *.htaccess (pattern, not just the
+              literal name), *.js *.html *.htm, and ANY file that gains +x.
+  Noise     : *.log *.tmp *.swp *~ and editor locks, media (*.jpg *.png *.css ...),
+              and anything under cache/session trees.
+  Meaningful: a change counts only if the file's CONTENT changed (size/mtime) or
+              it GAINED execute permission. atime / ownership / non-exec mode
+              changes are NOT meaningful and must not trigger a scan.
+"""
+from __future__ import annotations
+
+import fnmatch
+
+# Names that can carry server-side code -> relevant on name alone.
+RELEVANT_GLOBS = (
+    "*.php", "*.phtml", "*.php5", "*.phar", "*.inc",
+    "*.htaccess",                       # a pattern: inj_000061.htaccess counts too
+    "*.js", "*.html", "*.htm",
+)
+
+# Obvious noise -> never relevant on name alone (exec bit can still override, below).
+NOISE_GLOBS = (
+    "*.log", "*.tmp", "*.swp", "*.swx", "*.swpx", "*~",
+    ".*.swp",                           # vim lock files like .foo.php.swp
+    "*.jpg", "*.jpeg", "*.png", "*.gif", "*.ico", "*.css",
+)
+
+# Directory path fragments to exclude wholesale (high-churn, non-code).
+EXCLUDE_DIR_FRAGMENTS = (
+    "/wp-content/cache/",
+    "/cache/",
+    "/sessions/",
+    "/.git/",
+    "/node_modules/",
+)
+
+
+def _basename(path: str) -> str:
+    return path.rsplit("/", 1)[-1]
+
+
+def is_excluded_dir(path: str) -> bool:
+    return any(frag in path for frag in EXCLUDE_DIR_FRAGMENTS)
+
+
+def name_is_noise(path: str) -> bool:
+    name = _basename(path)
+    return any(fnmatch.fnmatch(name, g) for g in NOISE_GLOBS)
+
+
+def name_is_relevant(path: str) -> bool:
+    name = _basename(path)
+    return any(fnmatch.fnmatch(name, g) for g in RELEVANT_GLOBS)
+
+
+def has_exec_bit(mode: int) -> bool:
+    return bool(mode & 0o111)
+
+
+def is_candidate(path: str, mode: int) -> bool:
+    """Cheap pre-filter from path + current mode — no content read.
+
+    True if this file could ever be in scope:
+      * not in an excluded directory, AND
+      * either it currently has +x (any executable file is suspicious,
+        regardless of extension), OR its name matches a code pattern and is
+        not obvious noise.
+    """
+    if is_excluded_dir(path):
+        return False
+    if has_exec_bit(mode):
+        return True                     # exec bit trumps name/extension
+    if name_is_noise(path):
+        return False
+    return name_is_relevant(path)
+
+
+def fingerprint(st) -> tuple:
+    """A value that changes ONLY on a meaningful change.
+
+    Content change  -> st_size and/or st_mtime_ns move.
+    Gained/lost +x  -> has_exec_bit flips.
+    atime           -> ignored (not in the tuple).
+    ownership/gid   -> ignored.
+    chmod 644->600  -> ignored (exec bit unchanged).
+
+    Takes an os.stat_result.
+    """
+    return (st.st_size, st.st_mtime_ns, has_exec_bit(st.st_mode))
diff --git a/detector/work_queue.py b/detector/work_queue.py
new file mode 100644
index 0000000..c74faa9
--- /dev/null
+++ b/detector/work_queue.py
@@ -0,0 +1,225 @@
+"""
+WorkQueue — the heart of the detector.
+
+It is a to-do list of files waiting to be sent to the scanner, with three jobs
+rolled into one small, thread-safe class:
+
+  1. coalescing  — the same file queued twice collapses into one entry, so a
+                   burst of writes before we send becomes a single job.
+  2. signature   — skip a change that did not *meaningfully* alter the file.
+                   A file's signature is (size, mtime, exec-bit): a content edit
+                   moves size/mtime, a `chmod +x` flips the exec-bit, but a
+                   chown- or atime-only change moves none of them, so we don't
+                   waste a scan on it.
+  3. cooldown    — after a file is scanned, rapid re-writes are held back for a
+                   short window so one busy file can't flood the limited scanner.
+                   The *latest* version is still delivered once the window ends,
+                   so we never silently drop the last change (no missed scans).
+
+One lock guards everything, so the watcher thread (producer) and the
+scanner-client thread (consumer) can share it safely.
+"""
+from __future__ import annotations
+
+import sqlite3
+import threading
+import time
+from collections import deque
+from dataclasses import dataclass
+
+
+@dataclass
+class Job:
+    path: str
+    reason: str          # "created" | "modified" | "replaced"
+    size: int
+    mtime_ns: int
+    is_exec: bool
+    observed_at: float   # wall-clock time we first noticed this change
+
+    @property
+    def sig(self):
+        # What counts as a "meaningful" change, per the scanner's definition:
+        # new/replaced content (size or mtime moves) or a new execute bit.
+        return (self.size, self.mtime_ns, self.is_exec)
+
+    def to_wire(self) -> dict:
+        return {
+            "path": self.path,
+            "reason": self.reason,
+            "size": self.size,
+            "mtime": round(self.mtime_ns / 1e9, 6),
+            "observed_at": round(self.observed_at, 6),
+        }
+
+
+class _Store:
+    """
+    Durable backing for jobs that have NOT yet been delivered (SQLite, WAL mode).
+
+    This is the crash-safety net: if the detector process itself dies while a
+    big backlog is waiting (e.g. the scanner was down), the backlog is on disk
+    and is reloaded on restart. We persist only the "still-to-send" set:
+
+      * enqueue  -> INSERT OR REPLACE   (path is the primary key, so re-queuing
+                    the same file just overwrites — coalescing for free)
+      * deliver  -> DELETE the exact version we sent (matched on path+observed_at,
+                    so a newer change that arrived meanwhile is kept)
+      * startup  -> load every row back onto the queue (recovery)
+
+    Cooldown/last-sent state is intentionally NOT persisted: losing it on a crash
+    can only cause a harmless extra scan, never a missed one.
+    """
+
+    def __init__(self, path: str):
+        self.db = sqlite3.connect(path, check_same_thread=False)
+        self.db.execute("PRAGMA journal_mode=WAL")      # fast, durable commits
+        self.db.execute("PRAGMA synchronous=NORMAL")
+        self.db.execute(
+            "CREATE TABLE IF NOT EXISTS pending ("
+            "path TEXT PRIMARY KEY, reason TEXT, size INTEGER, "
+            "mtime_ns INTEGER, is_exec INTEGER, observed_at REAL)")
+        self.db.commit()
+
+    def put(self, job: "Job") -> None:
+        self.db.execute("INSERT OR REPLACE INTO pending VALUES (?,?,?,?,?,?)",
+                        (job.path, job.reason, job.size, job.mtime_ns,
+                         int(job.is_exec), job.observed_at))
+        self.db.commit()
+
+    def delete(self, job: "Job") -> None:
+        self.db.execute("DELETE FROM pending WHERE path=? AND observed_at=?",
+                        (job.path, job.observed_at))
+        self.db.commit()
+
+    def load_all(self):
+        cur = self.db.execute("SELECT path, reason, size, mtime_ns, is_exec, "
+                              "observed_at FROM pending")
+        return [Job(p, r, s, m, bool(x), o) for (p, r, s, m, x, o) in cur.fetchall()]
+
+    def close(self) -> None:
+        self.db.close()
+
+
+class WorkQueue:
+    def __init__(self, cooldown: float = 5.0, db_path: str | None = None):
+        self.cooldown = cooldown
+        self._cond = threading.Condition()
+        self._ready = deque()        # paths ready to send, in arrival order
+        self._pending = {}           # path -> Job   (for every path in _ready)
+        self._deferred = {}          # path -> (Job, release_time)  held by cooldown
+        self._last_sent = {}         # path -> (sig, sent_time)     for dedup
+        self._stopped = False
+
+        # Optional durability. If no db_path, the queue is purely in-memory.
+        self._store = _Store(db_path) if db_path else None
+        if self._store:
+            recovered = self._store.load_all()
+            for job in recovered:
+                self._pending[job.path] = job
+                self._ready.append(job.path)
+            if recovered:
+                print(f"[detector/queue] recovered {len(recovered)} pending jobs "
+                      f"from {db_path}", flush=True)
+
+    # ------------------------------------------------------------------ #
+    #  Producer side (called by the watcher)
+    # ------------------------------------------------------------------ #
+    def offer(self, job: Job) -> None:
+        now = time.monotonic()
+        with self._cond:
+            p = job.path
+            if p in self._pending:                  # already queued -> keep newest
+                self._pending[p] = job
+                if self._store:
+                    self._store.put(job)
+                return
+            if p in self._deferred:                 # in cooldown -> keep newest
+                _, release = self._deferred[p]
+                self._deferred[p] = (job, release)
+                return
+
+            last = self._last_sent.get(p)
+            if last is not None:
+                last_sig, last_time = last
+                if last_sig == job.sig:             # nothing meaningful changed
+                    return
+                if now - last_time < self.cooldown:  # too soon -> hold for later
+                    self._deferred[p] = (job, last_time + self.cooldown)
+                    return
+
+            self._pending[p] = job                  # enqueue now
+            self._ready.append(p)
+            if self._store:
+                self._store.put(job)
+            self._cond.notify()
+
+    # ------------------------------------------------------------------ #
+    #  Consumer side (called by the scanner client)
+    # ------------------------------------------------------------------ #
+    def pop(self):
+        """Block until a job is ready to send; return None once stopped."""
+        with self._cond:
+            while not self._stopped:
+                self._promote_due()
+                if self._ready:
+                    p = self._ready.popleft()
+                    return self._pending.pop(p)
+                self._cond.wait(self._wait_time())
+            return None
+
+    def requeue(self, job: Job) -> None:
+        """Put a job back after a busy ack or a lost connection: retry first."""
+        with self._cond:
+            self._pending[job.path] = job
+            self._ready.appendleft(job.path)
+            if self._store:
+                self._store.put(job)            # still undelivered -> keep on disk
+            self._cond.notify()
+
+    def mark_sent(self, job: Job) -> None:
+        """Record a successful delivery: drop it from disk, remember it for dedup."""
+        with self._cond:
+            if self._store:
+                self._store.delete(job)         # delivered -> no longer needs recovery
+            self._last_sent[job.path] = (job.sig, time.monotonic())
+
+    def depth(self) -> int:
+        """Current backlog: jobs waiting to send plus jobs held by cooldown."""
+        with self._cond:
+            return len(self._ready) + len(self._deferred)
+
+    def close(self) -> None:
+        with self._cond:
+            if self._store:
+                self._store.close()
+                self._store = None
+
+    def stop(self) -> None:
+        with self._cond:
+            self._stopped = True
+            self._cond.notify_all()
+
+    # ------------------------------------------------------------------ #
+    #  Helpers (always called with the lock held)
+    # ------------------------------------------------------------------ #
+    def _promote_due(self) -> None:
+        """Move any cooled-down files back onto the ready queue."""
+        if not self._deferred:
+            return
+        now = time.monotonic()
+        due = [p for p, (_, release) in self._deferred.items() if release <= now]
+        for p in due:
+            job, _ = self._deferred.pop(p)
+            if p not in self._pending:
+                self._ready.append(p)
+            self._pending[p] = job
+            if self._store:                     # now authoritative to-send -> persist
+                self._store.put(job)
+
+    def _wait_time(self):
+        """How long pop() may sleep: until the next cooldown expires, or forever."""
+        if not self._deferred:
+            return None
+        soonest = min(release for _, release in self._deferred.values())
+        return max(0.0, min(1.0, soonest - time.monotonic()))
diff --git a/detector/workqueue.py b/detector/workqueue.py
new file mode 100644
index 0000000..e9bb2b9
--- /dev/null
+++ b/detector/workqueue.py
@@ -0,0 +1,139 @@
+"""
+workqueue.py — the single to-do list that sits between the fast kernel side and
+the slow scanner side. This one object encodes dedup, debounce, and retry.
+
+It is a priority queue ordered by a `not_before` timestamp, plus three maps:
+
+  _pending   : paths currently in the heap OR in-flight (sent, not yet acked).
+               Membership here is how we COALESCE — a second event for a path
+               that is already queued is dropped.
+  _last_fp   : path -> fingerprint we last successfully delivered. Used to drop
+               NON-MEANINGFUL changes (same content + same exec bit).
+  _last_sent : path -> monotonic time we last delivered. Used for DEBOUNCE.
+
+Debounce is implemented as *defer, not drop*: a real change that lands inside
+the cooldown window is scheduled (via not_before) to send when the window ends,
+so a lone change is never lost — it is at most delayed by the window.
+
+Thread-safe: a single Condition guards all state. One or more producer threads
+call offer(); one consumer thread calls take()/ack()/requeue().
+"""
+from __future__ import annotations
+
+import heapq
+import threading
+import time
+
+
+class WorkQueue:
+    def __init__(self, debounce_s: float, max_pending: int = 500_000):
+        self._debounce = debounce_s
+        self._max_pending = max_pending
+
+        self._heap: list = []           # (not_before_mono, seq, path, observed_at, was_move)
+        self._seq = 0
+        self._pending: set[str] = set()
+        self._last_fp: dict[str, tuple] = {}
+        self._last_sent: dict[str, float] = {}
+
+        self._cv = threading.Condition()
+        self._stopped = False
+
+        self.stats = dict(offered=0, coalesced=0, nochange=0, debounced=0,
+                          enqueued=0, dropped_full=0, delivered=0, busy=0)
+
+    # ----- producer side ------------------------------------------------- #
+    def offer(self, path: str, fp: tuple, observed_at: float, was_move: bool) -> None:
+        now = time.monotonic()
+        with self._cv:
+            self.stats["offered"] += 1
+
+            if path in self._pending:                 # already queued/in-flight
+                self.stats["coalesced"] += 1
+                return
+            if self._last_fp.get(path) == fp:         # no meaningful change
+                self.stats["nochange"] += 1
+                return
+            if len(self._pending) >= self._max_pending:
+                self.stats["dropped_full"] += 1       # last-resort backstop; see rationale
+                return
+
+            not_before = now
+            last = self._last_sent.get(path)
+            if last is not None and (now - last) < self._debounce:
+                not_before = last + self._debounce    # defer to end of cooldown
+                self.stats["debounced"] += 1
+
+            self._seq += 1
+            heapq.heappush(self._heap,
+                           (not_before, self._seq, path, observed_at, was_move))
+            self._pending.add(path)
+            self.stats["enqueued"] += 1
+            self._cv.notify()
+
+    # ----- consumer side ------------------------------------------------- #
+    def take(self):
+        """Block until the earliest item is due; return it, or None if stopped.
+
+        The returned path STAYS in _pending (it is now in-flight) until ack()
+        or drop() is called.
+        """
+        with self._cv:
+            while not self._stopped:
+                if not self._heap:
+                    self._cv.wait()
+                    continue
+                not_before = self._heap[0][0]
+                now = time.monotonic()
+                if not_before <= now:
+                    _, _, path, observed_at, was_move = heapq.heappop(self._heap)
+                    return path, observed_at, was_move
+                self._cv.wait(timeout=not_before - now)
+            return None
+
+    def ack(self, path: str, fp: tuple) -> None:
+        """Scanner accepted the job: record delivery, free the path."""
+        with self._cv:
+            self._pending.discard(path)
+            self._last_fp[path] = fp
+            self._last_sent[path] = time.monotonic()
+            self.stats["delivered"] += 1
+
+    def requeue(self, path: str, observed_at: float, was_move: bool,
+                delay: float) -> None:
+        """Put an un-delivered job back (busy / disconnect). Keeps it pending."""
+        with self._cv:
+            self._seq += 1
+            heapq.heappush(self._heap,
+                           (time.monotonic() + delay, self._seq, path,
+                            observed_at, was_move))
+            self._pending.add(path)
+            self.stats["busy"] += 1
+            self._cv.notify()
+
+    def drop(self, path: str) -> None:
+        """Abandon a job (file vanished / change reverted / bad_request)."""
+        with self._cv:
+            self._pending.discard(path)
+
+    # ----- helpers ------------------------------------------------------- #
+    def last_fp_of(self, path: str):
+        with self._cv:
+            return self._last_fp.get(path)
+
+    def seen(self, path: str) -> bool:
+        with self._cv:
+            return path in self._last_fp
+
+    def depth(self) -> int:
+        with self._cv:
+            return len(self._heap)
+
+    def pending_count(self) -> int:
+        with self._cv:
+            return len(self._pending)
+
+    def stop(self) -> None:
+        with self._cv:
+            self._stopped = True
+            self._cv.notify_all()
