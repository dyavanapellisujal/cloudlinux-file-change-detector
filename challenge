#!/usr/bin/env python3
"""
`challenge` — one entry point for the candidate fixtures.

  challenge seed     [seed-generator args]        # lay down the account tree
  challenge scanner  [scanner-stub args]          # run the scanning service
  challenge load     [change-load-generator args] # drive file changes
  challenge version

The reviewer-only scorecard and the load generator's --oracle are NOT part of the candidate
workflow and are intentionally absent from the candidate Docker image.
"""
import os
import runpy
import sys

HOME = os.environ.get("CHALLENGE_HOME", os.path.dirname(os.path.abspath(__file__)))
TOOLS = {
    "seed": "seed_generator/seed_generator.py",
    "scanner": "scanner_stub/scanner_stub.py",
    "load": "change_load_generator/load_generator.py",
}
VERSION = "0.1.0"


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = sys.argv[1]
    if cmd == "version":
        print(f"challenge fixtures {VERSION}")
        return 0
    if cmd not in TOOLS:
        print(f"unknown command: {cmd}\n", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    script = os.path.join(HOME, TOOLS[cmd])
    sys.argv = [script] + sys.argv[2:]   # hand the rest to the tool's own argparse
    runpy.run_path(script, run_name="__main__")
    return 0


if __name__ == "__main__":
    sys.exit(main())
